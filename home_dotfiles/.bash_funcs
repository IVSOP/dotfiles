#!/bin/bash

function setup_code_sway() {
    local WORKSPACE_ID
    WORKSPACE_ID=$(swaymsg -t get_workspaces | jq '.[] | select(.focused == true) | .id')

    swaymsg split horizontal
    code .

    while ! swaymsg -t get_workspaces | jq --argjson id "$WORKSPACE_ID" '.[] | select(.id == $id) | .representation' | grep -qi code; do
        sleep 1
    done

    swaymsg move left, resize grow width 0 px or 15 ppt
    swaymsg focus prev
    swaymsg split vertical
    clear
}

function setup_code_hypr() {
    local WORKSPACE_ID
    WORKSPACE_ID=$(hyprctl activeworkspace -j | jq '.id')

    # Window rule: force the next vscode window onto this workspace (no silent — let it take focus)
    hyprctl eval "hl.window_rule({ name = 'setup_code_ws', match = { class = 'code' }, workspace = '$WORKSPACE_ID' })"

    # Launch vscode
    code . &

    # Wait for the vscode window to appear
    until hyprctl clients -j | jq -e '.[] | select(.class == "code")' > /dev/null 2>&1; do
        sleep 0.3
    done
    sleep 0.5  # let it settle

    # Remove the one-shot rule
    hyprctl eval "hl.window_rule({ name = 'setup_code_ws', remove = true })" 2>/dev/null

    # Vscode now has focus — move it left and grow to ~70%
    hyprctl eval 'local hy3 = hl.plugin.hy3; hl.dispatch(hy3.move_window("l"))'
    local mon_width
    mon_width=$(hyprctl monitors -j | jq '.[] | select(.focused) | (.width / .scale | floor)')
    local grow=$(( mon_width * 20 / 100 ))
    hyprctl eval "hl.dispatch(hl.dsp.window.resize({ x = $grow, y = 0, relative = true }))"

    # Focus back to terminal and make a vertical split
    hyprctl eval 'local hy3 = hl.plugin.hy3; hl.dispatch(hy3.move_focus("r"))'
    hyprctl eval 'local hy3 = hl.plugin.hy3; hl.dispatch(hy3.make_group("v"))'
    clear
}

function setup_code() {
    if [[ "$XDG_CURRENT_DESKTOP" == "Hyprland" ]]; then
        setup_code_hypr
    else
        setup_code_sway
    fi
}

function compress() {
    if [ "$#" -lt 1 ]; then
        echo "Not enough args: {OUTPUT} [FILENAMES] or {FILE}, there the output will be FILE.tar.zst"
        echo "Command used is tar -cf - [FILENAMES] | pv -s \$(du -bc [FILENAMES] | tail -n 1 | cut -f 1) | zstd -10 --long --threads=0 --stdout > {OUTPUT}"
        return 1
    fi

    if [ "$#" -eq 1 ]; then
        # Single file case: use input file as source and append .tar.zst for output
        local input_file="$1"
        local output_file="${input_file}.tar.zst"
        tar -cf - "$input_file" | pv -s $(du -bc "$input_file" | tail -n 1 | cut -f 1) | zstd -10 --long --threads=0 --stdout > "$output_file"
    else
        # Multiple files case: first arg is output, rest are input files
        tar -cf - "${@:2}" | pv -s $(du -bc "${@:2}" | tail -n 1 | cut -f 1) | zstd -10 --long --threads=0 --stdout > "$1"
    fi
}

function decompress() {
    if [ "$#" -lt 1 ]
    then
        echo "Not enough args"
        return 1
    fi
    local decompressed_size=$(zstd -l -v "$1" 2>/dev/null | grep Compressed | cut -d ' ' -f5 | cut -d \( -f2)
    zstd --decompress --threads=0 "$1" --stdout | pv -s $decompressed_size | tar -x -f -
}

function warp() {
    if [ "$#" -lt 1 ]
    then
        echo "Not enough args"
        return 1
    fi

    sudo systemctl $1 warp-svc.service
}

# screenshot copy
function sc() {
    # Screenshots are saved as AVIF, which nothing pastes yet, so decode to PNG.
    ffmpeg -v error -i "$HOME/Pictures/Screenshots/$(\ls ~/Pictures/Screenshots | tail -n 1)" \
        -f image2pipe -vcodec png - | wl-copy --type image/png
}

# screenshot delete
function sd() {
    local image_path
    # Sort by name, not mtime: names are YYYY_MM_DD-HHMMSS and mtimes were all
    # flattened by the bulk AVIF conversion.
    image_path="$HOME/Pictures/Screenshots/$(\ls "$HOME/Pictures/Screenshots" | tail -n 1)"

    chafa "$image_path" # --size=x$(( $(tput lines) / 2 )) $IMAGE_PATH

    if gum confirm "Remove $(basename "$image_path")?"
    then
        rm -v -- "$image_path"
    else
        echo "Not deleting"
    fi
}

# open nemo
function files() {
    nemo $1 &> /dev/null & disown
}

# get file from downloads
function dl() {
    local src
    if [ $# -gt 0 ]; then
        src=~/Downloads/"$1"
    else
        file=$(eza --sort oldest ~/Downloads | fzf --multi --ansi | tr -d "'")
        [ -z "$file" ] && return 1
        src=~/Downloads/"$file"
    fi
    mv "$src" .
}

# this assumes input is a single file, idc
function encrypt() {
    if [ "$#" -lt 1 ]
    then
        echo "Not enough args: {INPUT}. Output will be a .age"
        return 1
    fi

    local filename="$1"
    local output="${filename}.age"

    age --passphrase --output $output $filename
}

function decrypt() {
    if [ "$#" -lt 1 ]
    then
        echo "Not enough args: {INPUT}. Output is generated automatically"
        return 1
    fi

    local filename="$1"
    local result_filename

    # if name ends in .age, remove the .age extension from the output
    if [[ "$filename" =~ \.age$ ]]; then
        result_filename="${filename%.age}"
    else
        result_filename="$filename"
    fi

    age --decrypt --output $result_filename "$1"
}

function compress-encrypt() {
    if [ "$#" -lt 2 ]
    then
        echo "Not enough args: {OUTPUT (.tar.zst.age)} [FILENAMES]"
        return 1
    fi

    tar -cf - "${@:2}" \
        | pv -s $(du -bc "${@:2}" | tail -n 1 | cut -f 1) \
        | zstd -10 --long --threads=0 --stdout \
        | age --passphrase --output "$1"
}

function tar-encrypt() {
    if [ "$#" -lt 1 ]
    then
        echo "Not enough args: FILENAME or OUTPUT(.tar.age) [FILENAMES]"
        return 1
    fi


    if [ "$#" -eq 1 ]; then
        local output="$1.tar.age"
        tar -cf - $1 | pv -s $(du -bc "$1" | tail -n 1 | cut -f 1) | age --passphrase --output $output
    else
        local output="$1"
        tar -cf - "${@:2}" | pv -s $(du -bc "${@:2}" | tail -n 1 | cut -f 1) | age --passphrase --output $output
    fi
}

function decompress-decrypt() {
    if [ "$#" -lt 1 ]
    then
        echo "Not enough args"
        return 1
    fi
    age --decrypt --output - "$1" \
        | zstd --decompress --threads=0 - --stdout \
        | tar -x -f -
}

function decompress-tar() {
    if [ "$#" -lt 1 ]
    then
        echo "Not enough args"
        return 1
    fi
    age --decrypt --output - "$1" \
        | pv -s $(du -bc "$1" | tail -n 1 | cut -f 1) \
        | tar -x -f -
}

from() {
  local host="" dir choice start_in_root=0 folder=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --root) start_in_root=1; shift ;;
      --folder) folder="$2"; shift 2 ;;
      -h | --help)
        echo "Usage: from [--root] [--folder PATH] user@host"
        echo "  --root          Start browsing from / instead of ~"
        echo "  --folder PATH   Download PATH directly (skip fzf)"
        return 0
        ;;

      *) host="$1"; shift ;;
    esac
  done

  if [[ -z "$host" ]]; then
    echo "Usage: from [--root] [--folder PATH] user@host"
    return 1
  fi

  _q() { printf "%q" "$1"; }
  _q_or_raw_tilde() {
    if [[ "$1" == ~* ]]; then printf "%s" "$1"; else _q "$1"; fi
  }

  _remote_is_dir() {
    local p="$1"
    ssh "$host" "d=$(_q_or_raw_tilde "$p"); [ -d \"\$d\" ]"
  }

  _remote_list() {
    local p="$1"
    ssh "$host" "d=$(_q_or_raw_tilde "$p"); find \"\$d\" -maxdepth 1 ! -path \"\$d\" -printf '%P\n'"
  }

  if [[ -n "$folder" ]]; then
    if _remote_is_dir "$folder"; then
      scp -r "$host:$(_q_or_raw_tilde "$folder")" .
    else
      scp    "$host:$(_q_or_raw_tilde "$folder")" .
    fi
    return $?
  fi

  if [[ $start_in_root -eq 1 ]]; then
    dir="/"
  else
    dir="~"
  fi

  while true; do
    choice=$(
      _remote_list "$dir" | fzf --prompt="Remote [$host:$dir] ▶ "
    ) || return 1

    if _remote_is_dir "$dir/$choice"; then
      dir="$dir/$choice"
    else
      break
    fi
  done

  if _remote_is_dir "$dir/$choice"; then
    scp -r "$host:$(_q_or_raw_tilde "$dir/$choice")" .
  else
    scp    "$host:$(_q_or_raw_tilde "$dir/$choice")" .
  fi
}

cff() {
  local file
  file=$(fzf) || return
  [ -n "$file" ] && code "$file"
}

send_to_server() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: send_to_server FILE [FILE...]"
    return 1
  fi
  rsync -avP "$@" server:
}

send_to_server_compressed() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: send_to_server_compressed FILE [FILE...]"
    return 1
  fi
  rsync -avPz "$@" server:
}

get_from_server() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: get_from_server REMOTE_PATH [REMOTE_PATH...]"
    return 1
  fi
  local remote_path
  local -a sources=()
  for remote_path in "$@"; do
    sources+=("server:$remote_path")
  done
  rsync -avP --protect-args -- "${sources[@]}" .
}

get_from_server_compressed() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: get_from_server_compressed REMOTE_PATH [REMOTE_PATH...]"
    return 1
  fi
  local remote_path
  local -a sources=()
  for remote_path in "$@"; do
    sources+=("server:$remote_path")
  done
  rsync -avPz --protect-args -- "${sources[@]}" .
}

hotwallet() {
  cd /tmp && \
  decompress-decrypt $HOME/priv/hot_wallet.tar.zst.age && \
  cd hot_wallet
}

coldwallet() {
  cd /tmp && \
  decompress-decrypt $HOME/priv/wallet.tar.zst.age && \
  cd wallet
}

# Login once per machine; Docker stores the credentials.
ivcr_login() (
    set +x
    if [ "$#" -ne 0 ]; then
        printf 'Usage: ivcr_login\n' >&2
        return 1
    fi
    local password
    password=$(gum input --password --prompt 'Registry password: ') || return
    if [ -z "$password" ]; then
        printf 'Password cannot be empty.\n' >&2
        return 1
    fi
    printf '%s\n' "$password" | docker login ivcr.server.ivsop.dev \
        --username ivsopi3 --password-stdin
)

_ivcr_push_image() {
    local image_id image_hash app image_tag reference manifest_result
    local component='[a-z0-9]+(([._]|__|-+)[a-z0-9]+)*'
    local app_pattern="^${component}(/${component})*$"

    image_id=$(docker image inspect --format '{{.Id}}' "$1") || return
    if ! [[ "$image_id" =~ ^sha256:[a-f0-9]{64}$ ]]; then
        printf 'Could not determine the image SHA-256 ID.\n' >&2
        return 1
    fi
    image_hash=${image_id#sha256:}
    app=$(gum input --prompt 'App name: ' --value "${3:-${PWD##*/}}") || return
    if ! [[ "$app" =~ $app_pattern ]]; then
        printf 'Use a lowercase Docker repository name, e.g. my-app or team/my-app.\n' >&2
        return 1
    fi
    image_tag=$(gum input --prompt 'Tag: ' --value "$image_hash" --char-limit 128) || return
    local tag_pattern='^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$'
    if ! [[ "$image_tag" =~ $tag_pattern ]]; then
        printf 'Invalid Docker tag: use 1-128 letters, digits, _, . or -; no leading dot or hyphen.\n' >&2
        return 1
    fi
    reference="ivcr.server.ivsop.dev/$app:$image_tag"
    printf '\nSource: %s\nApp: %s\nImage: %s\nTag: %s\nDestination: %s\n\n' \
        "$2" "$app" "$image_id" "$image_tag" "$reference"
    gum confirm --default=false 'Upload this image?' || return

    if manifest_result=$(docker manifest inspect "$reference" 2>&1); then
        gum confirm --default=false "This tag already exists in the registry:
$reference
Are you sure you want to update it to this image?" || return
    else
        case "$manifest_result" in
            *'manifest unknown'*|*'MANIFEST_UNKNOWN'*|*'no such manifest:'*) ;;
            *)
                printf 'Could not check whether the image already exists:\n%s\n' "$manifest_result" >&2
                return 1
                ;;
        esac
    fi

    docker image tag "$image_id" "$reference" && docker image push "$reference"
}

# Upload an image archive produced by docker save.
ivcr_upload() {
    if [ "$#" -ne 1 ] || [ ! -f "$1" ]; then
        printf 'Usage: ivcr_upload IMAGE.tar\n' >&2
        return 1
    fi
    local output line image
    local -a images=()
    output=$(docker image load --input "$1") || return
    printf '%s\n' "$output"
    while IFS= read -r line; do
        case "$line" in
            'Loaded image: '*) images+=("${line#Loaded image: }") ;;
            'Loaded image ID: '*) images+=("${line#Loaded image ID: }") ;;
        esac
    done <<< "$output"
    if [ "${#images[@]}" -eq 0 ]; then
        printf 'No image was found in the archive.\n' >&2
        return 1
    fi
    for image in "${images[@]}"; do break; done
    if [ "${#images[@]}" -gt 1 ]; then
        image=$(gum choose --header 'Image to upload:' -- "${images[@]}") || return
    fi
    local app_default="${PWD##*/}" image_prefix
    # Preserve the selected image's repository, removing its tag and registry.
    if ! [[ "$image" =~ ^sha256:[a-f0-9]{64}$ ]]; then
        app_default=${image%%@*}
        case "${app_default##*/}" in
            *:*) app_default=${app_default%:*} ;;
        esac
        image_prefix=${app_default%%/*}
        if [[ "$app_default" == */* ]]; then
            case "$image_prefix" in
                *.*|*:*|localhost) app_default=${app_default#*/} ;;
            esac
        fi
    fi
    _ivcr_push_image "$image" "$1" "$app_default"
}

# Build the Dockerfile in the current directory, then upload the result.
ivcr_build_upload() {
    if [ "$#" -ne 0 ]; then
        printf 'Usage: ivcr_build_upload\n' >&2
        return 1
    fi
    local image
    image=$(docker build --quiet .) || return
    _ivcr_push_image "$image" "Build in $PWD"
}
